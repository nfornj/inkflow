{
  "name": "inkflow",
  "version": "1.0.0",
  "description": "InkFlow - Intelligent PDF viewer and browser with AI-powered document analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",
    "dev:react": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "postinstall": "cd frontend && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/test/autofill-engine.test.js src/test/prompt-manager.test.js",
    "test:integration": "jest src/test/integration.test.js",
    "test:performance": "jest src/test/performance.test.js",
    "test:cross-platform": "jest src/test/cross-platform.test.js",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "inkflow",
    "electron",
    "pdf",
    "browser",
    "ai",
    "document",
    "viewer",
    "intelligent",
    "flow"
  ],
  "author": "neekrish",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "dotenv": "^17.2.2",
    "electron-store": "^8.1.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2",
    "node-llama-cpp": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "tesseract.js": "^6.0.1"
  },
  "build": {
    "appId": "com.neekrish.inkflow",
    "productName": "InkFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "frontend/build/**/*"
    ],
    "extraResources": [
      {
        "from": "src/shared/models.json",
        "to": "models.json"
      },
      {
        "from": "src/shared/prompts.json",
        "to": "prompts.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nodeGypRebuild": true,
    "buildDependenciesFromSource": true
  }
}
